@baseUrl = http://127.0.0.1:8000

### ==========================================
### FLUJO CASCADA BACKEND
### Ejecutar de arriba hacia abajo sin cambios
### Asume base relativamente limpia
### ==========================================

### ==========================================
### 1. CATEGORIAS
### Crear, listar, obtener, actualizar y error
### ==========================================

### 1.1 Crear Categoria 1 - Root
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "Bebidas",
  "descripcion": "Categoria principal",
  "imagen_url": "http://img/bebidas",
  "parent_id": null
}

### 1.2 Crear Categoria 2 - Hija de Bebidas
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "Cafe",
  "descripcion": "Subcategoria de bebidas",
  "imagen_url": "http://img/cafe",
  "parent_id": 1
}

### 1.3 Crear Categoria 3 - Otra principal
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "Panaderia",
  "descripcion": "Categoria secundaria",
  "imagen_url": "http://img/panaderia",
  "parent_id": null
}

### 1.4 Listar Categorias
GET {{baseUrl}}/categorias/?offset=0&limit=10

### 1.5 Listar Categorias Principales
GET {{baseUrl}}/categorias/principales?offset=0&limit=10

### 1.6 Ver Arbol de Categorias
GET {{baseUrl}}/categorias/arbol

### 1.7 Obtener Categoria 1
GET {{baseUrl}}/categorias/1

### 1.8 Ver Subcategorias de Categoria 1
GET {{baseUrl}}/categorias/1/subcategorias?offset=0&limit=10

### 1.9 Actualizar Categoria 2
PATCH {{baseUrl}}/categorias/2
Content-Type: application/json

{
  "descripcion": "Subcategoria de cafe y bebidas calientes"
}

### Error 1: Intentar generar ciclo
PATCH {{baseUrl}}/categorias/1
Content-Type: application/json

{
  "parent_id": 2
}


### ==========================================
### 2. INGREDIENTES
### Crear, listar, obtener, actualizar
### ==========================================

### 2.1 Crear Ingrediente 1
POST {{baseUrl}}/ingredientes/
Content-Type: application/json

{
  "nombre": "Azucar",
  "descripcion": "Ingrediente base",
  "es_alergeno": true
}

### 2.2 Crear Ingrediente 2
POST {{baseUrl}}/ingredientes/
Content-Type: application/json

{
  "nombre": "Cafe Molido",
  "descripcion": "Ingrediente principal",
  "es_alergeno": false
}

### 2.3 Listar Ingredientes
GET {{baseUrl}}/ingredientes/?offset=0&limit=10

### 2.4 Listar Ingredientes Alergenos
GET {{baseUrl}}/ingredientes/alergenos?offset=0&limit=10

### 2.5 Obtener Ingrediente 1
GET {{baseUrl}}/ingredientes/1

### 2.6 Actualizar Ingrediente 1
PATCH {{baseUrl}}/ingredientes/1
Content-Type: application/json

{
  "descripcion": "Ingrediente dulce actualizado"
}


### ==========================================
### 3. PRODUCTOS
### Crear, listar, obtener, actualizar
### ==========================================

### 3.1 Crear Producto 1
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Cafe Latte",
  "descripcion": "Producto de prueba",
  "precio_base": 1200,
  "imagenes_url": ["http://img/latte"],
  "stock_cantidad": 15,
  "disponible": true
}

### 3.2 Crear Producto 2
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Cafe Negro",
  "descripcion": "Producto simple",
  "precio_base": 900,
  "imagenes_url": ["http://img/negro"],
  "stock_cantidad": 20,
  "disponible": true
}

### 3.3 Listar Productos
GET {{baseUrl}}/productos/?offset=0&limit=10

### 3.4 Obtener Producto 1
GET {{baseUrl}}/productos/1

### 3.5 Actualizar Producto 1
PATCH {{baseUrl}}/productos/1
Content-Type: application/json

{
  "precio_base": 1350,
  "stock_cantidad": 12
}


### ==========================================
### 4. PRODUCTO-CATEGORIAS
### Crear relaciones, listar y actualizar principal
### ==========================================

### 4.1 Relacionar Producto 1 con Categoria 2 como principal
POST {{baseUrl}}/producto-categorias/
Content-Type: application/json

{
  "producto_id": 1,
  "categoria_id": 2,
  "es_principal": true
}

### 4.2 Relacionar Producto 1 con Categoria 3
POST {{baseUrl}}/producto-categorias/
Content-Type: application/json

{
  "producto_id": 1,
  "categoria_id": 3,
  "es_principal": false
}

### 4.3 Ver Categorias del Producto 1
GET {{baseUrl}}/producto-categorias/producto/1

### 4.4 Ver Productos de la Categoria 3
GET {{baseUrl}}/producto-categorias/categoria/3

### 4.5 Pasar Categoria 3 a principal
PATCH {{baseUrl}}/producto-categorias/producto/1/categoria/3
Content-Type: application/json

{
  "es_principal": true
}

### 4.6 Ver Productos por Categoria 3
GET {{baseUrl}}/productos/categoria/3?offset=0&limit=10

### Error 2: Relacion duplicada
POST {{baseUrl}}/producto-categorias/
Content-Type: application/json

{
  "producto_id": 1,
  "categoria_id": 2,
  "es_principal": false
}


### ==========================================
### 5. PRODUCTO-INGREDIENTES
### Crear relaciones, listar y actualizar
### ==========================================

### 5.1 Relacionar Producto 1 con Ingrediente 1
POST {{baseUrl}}/producto-ingredientes/
Content-Type: application/json

{
  "producto_id": 1,
  "ingrediente_id": 1,
  "es_removible": false
}

### 5.2 Relacionar Producto 1 con Ingrediente 2
POST {{baseUrl}}/producto-ingredientes/
Content-Type: application/json

{
  "producto_id": 1,
  "ingrediente_id": 2,
  "es_removible": true
}

### 5.3 Ver Ingredientes del Producto 1
GET {{baseUrl}}/producto-ingredientes/producto/1

### 5.4 Ver Productos del Ingrediente 1
GET {{baseUrl}}/producto-ingredientes/ingrediente/1

### 5.5 Actualizar Relacion Producto 1 - Ingrediente 1
PATCH {{baseUrl}}/producto-ingredientes/producto/1/ingrediente/1
Content-Type: application/json

{
  "es_removible": true
}

### 5.6 Ver Producto 1 final
GET {{baseUrl}}/productos/1

### Error 3: Relacion con ingrediente inexistente
POST {{baseUrl}}/producto-ingredientes/
Content-Type: application/json

{
  "producto_id": 1,
  "ingrediente_id": 999,
  "es_removible": false
}


### ==========================================
### 6. LIMPIEZA
### ==========================================

### 6.1 Eliminar Relacion Producto 1 - Ingrediente 1
DELETE {{baseUrl}}/producto-ingredientes/producto/1/ingrediente/1

### 6.2 Eliminar Relacion Producto 1 - Ingrediente 2
DELETE {{baseUrl}}/producto-ingredientes/producto/1/ingrediente/2

### 6.3 Eliminar Relacion Producto 1 - Categoria 3
DELETE {{baseUrl}}/producto-categorias/producto/1/categoria/3

### 6.4 Eliminar Relacion Producto 1 - Categoria 2
DELETE {{baseUrl}}/producto-categorias/producto/1/categoria/2

### 6.5 Eliminar Producto 2
DELETE {{baseUrl}}/productos/2

### 6.6 Eliminar Producto 1
DELETE {{baseUrl}}/productos/1

### 6.7 Eliminar Ingrediente 2
DELETE {{baseUrl}}/ingredientes/2

### 6.8 Eliminar Ingrediente 1
DELETE {{baseUrl}}/ingredientes/1

### 6.9 Eliminar Categoria 3
DELETE {{baseUrl}}/categorias/3

### 6.10 Eliminar Categoria 2
DELETE {{baseUrl}}/categorias/2

### 6.11 Eliminar Categoria 1
DELETE {{baseUrl}}/categorias/1
